<% layout("/layouts/boilerplate") %>

<body>
    <h3>All Listing</h3>
    <!-- <form method="GET" action="listings/new">
        <button >Create New Listing</button>
    </form> -->
    
        <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1 aa">
        <% for(let listing of allListing){ %>
            <a href="/listings/<%=listing._id%>">
        <div class="card" style="width: 20rem;">
        <img src="<%= listing.image %>" class="card-img-top" alt="listing image" style="height: 15rem;">
        <div class="card-img-overlay"></div>
        <div class="card-body">
        <p class="card-text"><b><%= listing.title%></b>
        <br>
        &#8377; <%= listing.price.toLocaleString("en-IN")%> / Night
        </p>
        </div>
    </div>
    </a>
    <%} %>
    </div>
    

    <!-- <ul>
        <% for(let listing of allListing){ %>
        <li><a href="/listings/<%=listing._id%>"><%= listing.title%></a></li>
    <%} %>
    </ul> -->
</body>
